# Every environment variable secure-notify reads (docs/operations/self-hosting.md#configuration).
# Copy to `.env` for local runs; `.env` is git-ignored. Empty values count as unset.

# Directory for the database and its backups. Default: data
DATA_DIR=.local/data

# Log level: error, warn, info, debug, or trace. Default: info
LOG_LEVEL=info

# Instance config file. Default: secure-notify.toml in DATA_DIR, when present.
CONFIG_FILE=

# Source code link shown by /about. Default: the canonical repository URL. Operators running a
# modified version MUST point it at their modified source.
SOURCE_URL=

# Telegram bot token from BotFather, for a test bot created for development. Secret: it can also
# be read from a file with TELEGRAM_BOT_TOKEN_FILE (setting both is an error).
TELEGRAM_BOT_TOKEN=
